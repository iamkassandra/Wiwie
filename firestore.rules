rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Fields: email (string), role (string: admin|editor), lastLogin (timestamp)
    //
    // Collection: tasks
    // Fields: title (string), description (string), status (string), priority (string), assignedTo (string), createdAt (timestamp)
    //
    // Collection: articles
    // Fields: title (string), content (string), category (string), author (string), status (string), createdAt (timestamp)
    //
    // Collection: agent_logs
    // Fields: userId (string), message (string), role (string), timestamp (timestamp)
    //
    // ===============================================================

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         request.auth.token.email == "theaucklandassistant@gmail.com");
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Validation Functions
    function isValidTask(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() < 200 &&
             data.status in ['todo', 'in-progress', 'done'] &&
             data.priority in ['low', 'medium', 'high'];
    }

    function isValidArticle(data) {
      return data.title is string && data.title.size() > 0 &&
             data.content is string &&
             data.status in ['draft', 'published'];
    }

    // Rules
    match /users/{userId} {
      allow read: if isAuthenticated() && (isOwner(userId) || isAdmin());
      allow write: if isAdmin() || (isAuthenticated() && isOwner(userId) && request.resource.data.role == resource.data.role);
    }

    match /tasks/{taskId} {
      allow read, write: if isAdmin();
    }

    match /articles/{articleId} {
      allow read: if true; // Publicly readable
      allow write: if isAdmin();
    }

    match /agent_logs/{logId} {
      allow read, write: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || isAdmin());
    }
  }
}
